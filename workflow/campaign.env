#!/bin/bash

# Immutable settings for one autoresearch campaign. Starting a campaign with
# different values requires a new RUNS_ROOT so results are never mixed.
N_FOLDS=5
CV_SEED=10141996
CV_VAL_OFFSET=1
EVAL_SPLIT=test
TRAIN_SEED=42

PRED_BATCH_SIZE=64
DEVICE=cuda

MOTIF_REGION=3utr
N_SCRAMBLES=10
MOTIF_STRATEGY=random_different
MOTIF_SEED=42

PEARSON_TOLERANCE=0.0001
MOTIF_TOLERANCE=0.000001
